{
  // GitHub Codespaces config: run DailyVerse in the cloud and open it from a phone browser.
  // Secrets (ANTHROPIC_API_KEY, etc.) come from Codespaces secrets, not a committed .env.
  "name": "DailyVerse",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "DailyVerse app", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": { "description": "Required - Claude API key for verse visual concepts" },
    "POLLINATIONS_API_KEY": { "description": "Optional - Pollinations image API key" },
    "HF_TOKEN": { "description": "Optional - Hugging Face token (needed for Indic-Parler TTS model)" },
    "YOUTUBE_CLIENT_ID": { "description": "Optional - YouTube upload" },
    "YOUTUBE_CLIENT_SECRET": { "description": "Optional - YouTube upload" },
    "YOUTUBE_REFRESH_TOKEN": { "description": "Optional - YouTube upload" }
  },
  // One-time setup when the codespace is created (npm deps + Piper TTS voices).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Every start/resume: launch the app in the background so a phone user only has to open the port.
  "postStartCommand": "bash .devcontainer/start.sh"
}
